# Prefer configuring via the Setup UI at http://localhost:3000/setup
# (writes .data/runtime-config.json and syncs this file). Or fill manually:

# Trigger.dev
TRIGGER_SECRET_KEY=tr_dev_xxx
TRIGGER_PROJECT_REF=proj_xxxxx

# AI — pick one provider via CYCLEFORGE_AI_PROVIDER
CYCLEFORGE_AI_PROVIDER=google
CYCLEFORGE_AI_MODEL=gemini-flash-latest

# Google AI Studio / Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_GENERATIVE_AI_MODEL=gemini-flash-latest

# OpenAI
# OPENAI_API_KEY=
# CYCLEFORGE_AI_PROVIDER=openai
# CYCLEFORGE_AI_MODEL=gpt-4o-mini

# Anthropic
# ANTHROPIC_API_KEY=
# CYCLEFORGE_AI_PROVIDER=anthropic
# CYCLEFORGE_AI_MODEL=claude-sonnet-4-0

# Local OpenAI-compatible (Ollama, LM Studio, etc.)
# CYCLEFORGE_AI_PROVIDER=openai-compatible
# OPENAI_API_KEY=local
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# CYCLEFORGE_AI_MODEL=local-model

# ClickHouse Cloud (or self-hosted HTTP endpoint)
CLICKHOUSE_URL=https://xxxxx.eu-west-1.aws.clickhouse.cloud:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=default

# OpenRouteService (optional — falls back to synthetic Amsterdam loops)
ORS_API_KEY=
