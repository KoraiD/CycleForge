# App-local ignores (root .gitignore also applies)

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report
/blob-report

# next.js
/.next/
/out/

# production
/build
/dist

# trigger.dev
/.trigger/

# misc
.DS_Store
*.pem
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local plan cache for summary deep-links
/.data/

# env
.env
.env.*
!.env.example

# vercel / typescript
.vercel
*.tsbuildinfo
next-env.d.ts
