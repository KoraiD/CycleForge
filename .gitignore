# =============================================================================
# CycleForge — strict repository ignore rules
# =============================================================================

# ----- OS / editor -----
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
Desktop.ini
ehthumbs.db
*~
*.swp
*.swo
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace
.history/
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# ----- Secrets & local env (never commit) -----
.env
.env.*
!.env.example
!**/.env.example
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
id_ed25519*
credentials.json
service-account*.json
secrets/
.secrets/
.direnv/
.vault/

# ----- Dependencies -----
node_modules/
**/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/
.npm/
bower_components/

# ----- Python / local tooling -----
.venv/
venv/
ENV/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.Python

# ----- Build / Next.js / Trigger -----
.next/
**/out/
**/build/
**/dist/
.turbo/
*.tsbuildinfo
next-env.d.ts
.trigger/
**/.trigger/
.vercel/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache

# ----- Tests / coverage / reports -----
coverage/
**/coverage/
.nyc_output/
test-results/
**/test-results/
playwright-report/
**/playwright-report/
blob-report/
**/blob-report/
junit.xml
*.lcov

# ----- Logs & debug -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- Hackathon / local-only materials -----
# Participant PDFs and local notes stay off the remote
*.pdf
docs/private/
tmp/
temp/
.scratch/
.data/
**/.data/

# ----- Misc generated -----
*.tgz
*.zip
*.tar
*.gz
.DS_Store?
Icon?
